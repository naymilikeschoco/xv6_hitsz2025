+  pte_t *ktable = (pte_t*)PTE2PA(k_pagetable[0]);
+  if(ktable == 0) return;
+  
+  // 清理用户空间范围：0x0 - 0xC0000000
+  for(int i = 0; i < 95; i++) {
+    ktable[i] = 0;
+  }
