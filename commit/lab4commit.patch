+const char* pte_flags_str(pte_t pte) {
+    static char flags[5];
+    int idx = 0;
+    
+    flags[idx++] = (pte & PTE_R) ? 'r' : '-';
+    flags[idx++] = (pte & PTE_W) ? 'w' : '-';
+    flags[idx++] = (pte & PTE_X) ? 'x' : '-';
